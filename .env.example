# --- Master API server (sodachat.api) -------------------------------------
# One process holds the models; every bot talks to it over HTTP, so running
# two bots no longer means two copies of a ~190MB model set.
#
#   python -m sodachat.api          # the models
#   python -m sodachat.discord_bot  # a bot, with SODACHAT_API_URL set
#
# Where the bots find it. Leave empty to load the models into the bot's own
# process instead (the single-bot arrangement, and what this did before).
SODACHAT_API_URL=

# Shared secret. When set, the server requires it on every route but /healthz
# (X-API-Key or Authorization: Bearer) and the bots send it.
SODACHAT_API_KEY=

# Where the server listens (defaults: 127.0.0.1:8765). Bind it to 0.0.0.0 only
# with SODACHAT_API_KEY set — this endpoint runs a model for whoever asks.
SODACHAT_API_HOST=127.0.0.1
SODACHAT_API_PORT=8765

# Discord: token from https://discord.com/developers/applications (Bot page)
DISCORD_BOT_TOKEN=

# Reply to every message the bot can read, not just DMs and @mentions (1/0)
DISCORD_RESPOND_ALL=0

# Google Chat webhook server port
GOOGLE_CHAT_PORT=8080

# Google Cloud project number; when set, incoming Google Chat requests are
# verified with google-auth (pip install google-auth)
GOOGLE_CHAT_AUDIENCE=

# Run the full agent (1/0, default 1): the routing specialist, /commands,
# games, and images or source files posted to a channel. Set to 0 for plain
# chat — the frontends' behaviour before the specialists. Read wherever the
# models are loaded: the API server, or the bot itself without one.
SODACHAT_AGENT=1

# Device the agent's models run on (cpu, cuda, mps). CPU is fine and default.
# Read where the models load (the API server, when there is one).
SODACHAT_DEVICE=cpu

# Model backend: mini (from-scratch GPT trained on SODA, default)
# or gpt2 (fine-tuned GPT-2 — training it needs >=16GB RAM or a GPU)
# Used by the plain-chat path (SODACHAT_AGENT=0) and the CLI.
SODACHAT_BACKEND=mini

# Disable the profanity filter on replies (1/0). Read where the models load.
# On by default, since a generative model can produce anything.
SODACHAT_UNFILTERED=0

# Personality of the replies: neutral (default), cheerful, deadpan, curious,
# grumpy, lowkey — or one of your own from personas.json. Applies to the CLI
# and to the chat frontends; /persona changes it live in a channel.
SODACHAT_PERSONA=neutral

# A different personas file (default: personas.json in the repo root).
# SODACHAT_PERSONAS=/path/to/personas.json

# How long replies may run: short, medium (default) or long. Sets the model's
# generation budget and the sentence/character trim together — raising one
# without the other just re-cuts a reply that was already cut off.
SODACHAT_REPLY_LENGTH=medium
