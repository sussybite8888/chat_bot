# Discord: token from https://discord.com/developers/applications (Bot page)
DISCORD_BOT_TOKEN=

# Reply to every message the bot can read, not just DMs and @mentions (1/0)
DISCORD_RESPOND_ALL=0

# Google Chat webhook server port
GOOGLE_CHAT_PORT=8080

# Google Cloud project number; when set, incoming Google Chat requests are
# verified with google-auth (pip install google-auth)
GOOGLE_CHAT_AUDIENCE=

# Model backend: mini (from-scratch GPT trained on SODA, default)
# or gpt2 (fine-tuned GPT-2 — training it needs >=16GB RAM or a GPU)
SODACHAT_BACKEND=mini

# Disable the profanity filter on replies for Discord/Google Chat (1/0).
# On by default, since a generative model can produce anything.
SODACHAT_UNFILTERED=0
